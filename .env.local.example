# Copy this file to .env.local and fill in real values.
#
# Setup steps:
#   1. Create a free account at https://resend.com/signup (no card required).
#   2. In the dashboard, go to API Keys > Create API Key, and paste it below.
#   3. Set CONTACT_TO_EMAIL to the address that should receive contact-form
#      submissions (e.g. the address you signed up to Resend with — the free
#      tier sends from the shared onboarding@resend.dev address without
#      needing to verify a custom domain).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
